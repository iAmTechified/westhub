APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
DB_TIMEOUT=3

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# One storage folder shared by BOTH apps. On cPanel set this to the same absolute
# path in the public site and the admin, e.g. /home/westgpac/westhub/storage/app/public,
# otherwise images uploaded in the admin 404 on the public website.
# Leave blank locally to use each app’s own storage/app/public.
PUBLIC_STORAGE_PATH=
PUBLIC_STORAGE_URL=/storage
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
WESTHUB_SUPPORT_EMAIL=support@example.com
WESTHUB_JOIN_HIRING_EMAILS=
WESTHUB_ADMIN_BASE_URL=http://localhost:8001

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

WESTHUB_CONTACT_EMAIL=info@westhubhealthcare.com
WESTHUB_CONTACT_PHONE="+1 2246250423"
# ---------------------------------------------------------------------------
# Appointments and integrations: FALLBACKS ONLY.
# Live values are managed in admin Settings, stored in the shared settings
# table, and take effect with no deploy. These are only used before a value
# has been saved in the admin.
# ---------------------------------------------------------------------------
APPOINTMENT_PROVIDER=calendly
CALENDLY_APPOINTMENT_URL=
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_CALENDAR_TIMEZONE=America/Chicago
GOOGLE_CALENDAR_EVENT_DURATION_MINUTES=60

# Shared content database used by both website and admin
CONTENT_DB_CONNECTION=content
CONTENT_DB_DRIVER=mysql
CONTENT_DB_HOST=127.0.0.1
CONTENT_DB_PORT=3306
CONTENT_DB_DATABASE=westhub_shared
CONTENT_DB_USERNAME=root
CONTENT_DB_PASSWORD=
CONTENT_DB_TIMEOUT=3

GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SHEET_NAME="Join Requests"
GOOGLE_SHEETS_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=

# Must be IDENTICAL in the public site and westhub-admin, or encrypted settings
# (Google service account keys) saved in the admin cannot be read by the website.
# Generate with: php artisan westhub:settings-key
SETTINGS_ENCRYPTION_KEY=
