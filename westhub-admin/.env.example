APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# One storage folder shared by BOTH apps. On cPanel set this to the same absolute
# path in the public site and the admin, e.g. /home/westgpac/westhub/storage/app/public,
# otherwise images uploaded in the admin 404 on the public website.
# Leave blank locally to use each app’s own storage/app/public.
PUBLIC_STORAGE_PATH=
PUBLIC_STORAGE_URL=/storage
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

WESTHUB_CONTACT_EMAIL=info@westhubhealthcare.com
WESTHUB_CONTACT_PHONE="+1 2246250423"
CALENDLY_APPOINTMENT_URL=

# Shared production content database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=westhub_shared
DB_USERNAME=root
DB_PASSWORD=

# SEO analytics providers
GA4_PROPERTY_ID=
GA4_CREDENTIALS_JSON=
SEARCH_CONSOLE_SITE_URL=
SEARCH_CONSOLE_CREDENTIALS_JSON=

# ---------------------------------------------------------------------------
# Appointments and integrations: FALLBACKS ONLY.
# Live values are managed in admin Settings, stored in the shared settings
# table, and take effect with no deploy. These are only used before a value
# has been saved in the admin.
# ---------------------------------------------------------------------------
APPOINTMENT_PROVIDER=calendly
CALENDLY_APPOINTMENT_URL=
# With APPOINTMENT_PROVIDER=google_booking_page: the appointment schedule's
# booking page link (Google Calendar > the schedule > Share).
GOOGLE_BOOKING_PAGE_URL=

# Google Calendar (appointments sync)
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_CALENDAR_TIMEZONE=UTC
GOOGLE_CALENDAR_EVENT_DURATION_MINUTES=60
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SHEET_NAME="Join Requests"
GOOGLE_SHEETS_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
# service_account (default) or apps_script. Apps Script needs no Google Cloud
# key: see docs/DEPLOYMENT.md 4.2. The secret matches the script's WESTHUB_SECRET.
GOOGLE_SHEETS_METHOD=
GOOGLE_SHEETS_APPS_SCRIPT_URL=
GOOGLE_SHEETS_APPS_SCRIPT_SECRET=

# Public website URL, used for voucher links in emails sent from the admin.
WESTHUB_PUBLIC_URL=

# Must be IDENTICAL in the public site and westhub-admin, or encrypted settings
# (Google service account keys) saved in the admin cannot be read by the website.
# Generate with: php artisan westhub:settings-key
SETTINGS_ENCRYPTION_KEY=

